# ============================================================================
# PHISGUARD - Environment Configuration Template
# ============================================================================
# Copy this file to .env and insert your API keys and credentials:
#   cp .env.example .env
#
# Free Tier API Key Registration Links:
# - Groq Cloud (Free high-speed LLM): https://console.groq.com/keys
# - VirusTotal v3 (Free 4 req/min):   https://www.virustotal.com/gui/my-apikey
# - urlscan.io (Free sandbox scan):    https://urlscan.io/user/signup
# - Discord Webhook (Alerting):        Server Settings -> Integrations -> Webhooks
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Threat Intelligence Scanners
# ----------------------------------------------------------------------------
# VirusTotal v3 API Key (64-character hex string)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# urlscan.io API Key (UUID format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
URLSCAN_API_KEY=your_urlscan_api_key_here

# Rate Limits and Timeouts
VIRUSTOTAL_RATE_LIMIT=4
VIRUSTOTAL_RATE_LIMIT_PERIOD=60.0
VIRUSTOTAL_TIMEOUT=30.0
URLSCAN_POLL_INTERVAL=5.0
URLSCAN_TIMEOUT=60.0
HTTP_REQUEST_TIMEOUT=15.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# ----------------------------------------------------------------------------
# 2. AI Threat Analyst Engine (Groq / OpenAI-compatible LLM)
# ----------------------------------------------------------------------------
# Groq API Key (starts with gsk_...)
LLM_API_KEY=your_groq_api_key_here

# Recommended Fast & Lightweight Models:
# - openai/gpt-oss-20b (Ultra-fast, low latency)
# - llama-3.3-70b-versatile (Deep forensic reasoning)
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# ----------------------------------------------------------------------------
# 3. SecOps Webhook Notifications (Discord / Slack)
# ----------------------------------------------------------------------------
# Discord Webhook URL for rich threat alert embeds
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ----------------------------------------------------------------------------
# 4. Optional Live Mailbox Watcher (IMAP Monitoring)
# ----------------------------------------------------------------------------
# For Gmail: Use 'imap.gmail.com', port 993, and generate a 16-character 'App Password'
# (Google Account -> Security -> 2-Step Verification -> App Passwords)
# For Outlook/Office365: Use 'outlook.office365.com', port 993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_16_char_app_password
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL=15.0
IMAP_USE_SSL=true
IMAP_MARK_AS_SEEN=true

# ----------------------------------------------------------------------------
# 5. Core Application & Memory Persistence
# ----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
MEMORY_DB_PATH=sentinel_memory.db
